{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "white": "#f7f7f7",
    "black": "#111111"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#81ff91",
    "foreground_templates": [
      "{{if gt .Code 0}}#ff3030{{end}}"
    ],
    "template": "\u276f "
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "background": "#464646",
          "foreground": "p:white",
          "options": {
            "windows": "\ue62a",
            "linux": "\uf17c",
            "ubuntu": "\uf31b",
            "macos": "\uf179"
          }
        },
        {
          "type": "session",
          "style": "plain",
          "background": "#ffe093",
          "foreground": "p:black",
          "template": " {{ .HostName }}@{{ .UserName }}\u2800"
        },
        {
        "type": "path",
        "style": "plain",
        "background": "p:white",
        "foreground": "p:black",
          "options": {
            "style": "full",
            "folder_separator_icon": "/"
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "background": "#FFFFD6",
          "foreground": "p:black",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#D97706{{ end }}",
            "{{ if gt .Ahead 0 }}#16A34A{{ end }}",
            "{{ if gt .Behind 0 }}#7C3AED{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#DC2626{{ end }}"
          ],
          "template": " ⎇ {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} ≡{{ .StashCount }}{{ end }} ",
          "properties": {
            "branch_icon": "",
            "branch_ahead_icon": "↑",
            "branch_behind_icon": "↓",
            "branch_identical_icon": "≡",
            "branch_gone": "≢",
            "commit_icon": "•",
            "merge_icon": "◧",
            "rebase_icon": "↺",
            "tag_icon": "◦",
            "cherry_pick_icon": "✓",
            "no_commits_icon": "∅",
            "fetch_status": true,
            "fetch_stash_count": true
          }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "background": "transparent",
          "foreground": "#b3ffde",
          "options": {
            "style": "austin",
            "threshold": 0
          },
          "template": " {{ .FormattedMs }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "background": "transparent",
          "foreground": "#81ff91",
          "foreground_templates": [
            "{{if gt .Code 0}}#ff3030{{end}}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": "\u276f"
        }
      ]
    }
  ],
  "console_title_template": "{{if .Root}}[root] {{end}}{{.Shell}} in <{{.Folder}}>",
  "final_space": true,
  "version": 4
}
