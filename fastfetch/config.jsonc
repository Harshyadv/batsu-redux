// Inspired by Catnap - Cleaned & Revamped (Dashed Open Right Borders)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
  "type": "small",
  //"source": "fedora",
  "padding": {
    "top": 3
    }
  },
  "display": {
    "separator": " │ ",
    "color": {
      "separator": "bright_black"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": " {#34}╭--- {#1}{#36}System Information{#0} {#34}----------------------------->{#0}"
    },
    {
      "type": "title",
      "key": " {#31}  user{#0}        ",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": " {#32}󰇅  hname{#0}       ",
      "format": "{host-name}"
    },
    {
      "type": "board",
      "key": " {#32}  chassis{#0}     "
    },
    {
      "type": "uptime",
      "key": " {#33}󰅐  uptime{#0}      "
    },
    {
      "type": "os",
      "key": " {#34}  os{#0}          "
    },
    {
      "type": "kernel",
      "key": " {#35}  kernel{#0}      "
    },
    {
      "type": "terminalfont",
      "key": " {#34}  termfont{#0}    "
    },
    {
      "type": "terminal",
      "key": " {#31}  term{#0}        "
    },
    {
      "type": "shell",
      "key": " {#32}  shell{#0}       "
    },
    {
      "type": "cpu",
      "key": " {#33}󰍛  cpu{#0}         ",
      "showPeCoreCount": true
    },
    {
      "type": "disk",
      "key": " {#34}󰉉  disk(C:){#0}    ",
      "folders": "C:\\"
    },
    {
      "type": "disk",
      "key": " {#34}󰉉  disk(D:){#0}    ",
      "folders": "D:\\"
    },
    {
      "type": "disk",
      "key": " {#34}󰉉  swap(E:){#0}    ",
      "folders": "E:\\"
    },
    {
      "type": "memory",
      "key": " {#35}  memory{#0}      "
    },
    {
      "type": "custom",
      "format": " {#34}├----------------------------------------------------->{#0}"
    },
    {
      "type": "colors",
      "key": " {#39}  colors{#0}      ",
      "symbol": "star"
    },
    {
      "type": "custom",
      "format": " {#34}╰----------------------------------------------------->{#0}"
    }
  ]
}
